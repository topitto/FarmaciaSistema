<Window x:Class="FarmaciaSistema.Desktop.CobroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Finalizar Venta - Cobro" Height="500" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#F0F2F5">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,20,0">
            <TextBlock DockPanel.Dock="Top" Text="Resumen de la Venta" 
                       FontSize="20" FontWeight="Bold" Foreground="#333" Margin="0,0,0,10"/>

            <ListView x:Name="ListaResumen" Background="White" BorderThickness="0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Producto" Width="200" DisplayMemberBinding="{Binding Nombre}"/>
                        <GridViewColumn Header="Cant." Width="50" DisplayMemberBinding="{Binding Cantidad}"/>
                        <GridViewColumn Header="Total" Width="80" DisplayMemberBinding="{Binding Subtotal, StringFormat=C}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </DockPanel>

        <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20">
            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="Total a Pagar" FontSize="16" Foreground="Gray" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtTotalPagar" Text="$0.00" FontSize="40" FontWeight="Bold" 
                           Foreground="#007ACC" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <Label Content="Efectivo Recibido:" FontSize="14" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtEfectivo" FontSize="24" Padding="5" 
                         TextChanged="TxtEfectivo_TextChanged" 
                         PreviewTextInput="TxtEfectivo_PreviewTextInput"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,30">
                    <TextBlock Text="Cambio: " FontSize="18" FontWeight="SemiBold" Foreground="#333"/>
                    <TextBlock x:Name="TxtCambio" Text="$0.00" FontSize="18" FontWeight="Bold" Foreground="#28A745"/>
                </StackPanel>

                <Button x:Name="BtnFinalizar" Content="CONFIRMAR VENTA" Height="50" 
                        Background="#28A745" Foreground="White" FontSize="16" FontWeight="Bold"
                        Click="BtnFinalizar_Click" IsEnabled="False" Cursor="Hand"/>

                <Button x:Name="BtnCancelar" Content="Cancelar / Volver" Height="40" 
                        Background="#DC3545" Foreground="White" Margin="0,10,0,0"
                        Click="BtnCancelar_Click" Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
