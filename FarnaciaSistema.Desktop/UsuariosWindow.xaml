<Window x:Class="FarmaciaSistema.Desktop.UsuariosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestión de Usuarios" Height="450" Width="800"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <DataGrid x:Name="UsuariosGrid" Grid.Column="0" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionChanged="UsuariosGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Usuario" Binding="{Binding NombreUsuario}" Width="*"/>
                <DataGridTextColumn Header="Rol" Binding="{Binding Rol}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <Label Content="ID"/>
            <TextBox x:Name="TxtId" IsReadOnly="True" Margin="0,0,0,10"/>

            <Label Content="Nombre de Usuario"/>
            <TextBox x:Name="TxtNombreUsuario" Margin="0,0,0,10"/>

            <Label Content="Contraseña"/>
            <PasswordBox x:Name="TxtPassword" Margin="0,0,0,5"/>
            <TextBlock Text="(Dejar vacía para no cambiar al editar)" FontSize="10" Foreground="Gray" Margin="0,0,0,10"/>

            <Label Content="Rol"/>
            <ComboBox x:Name="CboRol" Margin="0,0,0,20">
                <ComboBoxItem Content="Administrador"/>
                <ComboBoxItem Content="Farmacéutico"/>
                <ComboBoxItem Content="Doctor"/>
            </ComboBox>

            <Button x:Name="BtnGuardar" Content="Guardar" Click="BtnGuardar_Click" Margin="0,0,0,5"/>
            <Button x:Name="BtnEliminar" Content="Eliminar" Click="BtnEliminar_Click" Margin="0,0,0,5"/>
            <Button x:Name="BtnLimpiar" Content="Limpiar" Click="BtnLimpiar_Click"/>
        </StackPanel>
    </Grid>
</Window>
